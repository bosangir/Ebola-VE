# ===== EVE vaccine-effectiveness analysis =====
# Anything that identifies a person stays in the private folder OUTSIDE this
# repository (EVE_VE_PRIVATE_identifiers/). These patterns are a safety net in
# case such a file is ever copied in by mistake.

# Local configuration (may contain private paths)
config.local.R

# Identifiable or record-level files
EVE_VE_PRIVATE_identifiers/
raw_inputs/
*identifiable*
*crosswalk*
*qc_application_log*
*participant_level*
EVE_raw_*
*.json

# Generated R objects and run logs
Outputs/*.rds
Outputs/run_log.txt

# R session files
.Rproj.user/
.Rhistory
.RData
.Rprofile

# Office lock files and OS files
~$*
.DS_Store
Thumbs.db
desktop.ini
